, .job-card-container'));\n      if (!cards.length) return;\n      let list = cards[0].closest('.jobs-search-results-list, .scaffold-layout__list');\n      if (!list) {\n        let p = cards[0].parentElement;\n        while (p && p.scrollHeight <= p.clientHeight + 50) p = p.parentElement;\n        list = p;\n      }\n      if (!list) return;\n      for (let i = 0; i < 4; i++) {\n        const before = list.scrollTop;\n        list.scrollTop = list.scrollHeight;\n        if (list.scrollTop === before) break;\n        await sleep(600);\n      }\n    } catch (e) {}\n  };\n  try {\n    const card = document.querySelector('[data-job-list-item=\"active\"]');\n    const compMatch = card ? (card.getAttribute('componentkey') || '').match(/job-card-component-ref-(\\d+)/) : null;\n    const cardId = (card && (card.getAttribute('data-job-id') || (compMatch && compMatch[1]) || '')) || '';\n    const urlId = (location.href.match(/currentJobId=(\\d+)/) || [])[1] || '';\n    const expected = urlId || cardId || '';\n    const isResults = location.pathname.indexOf('search-results') >= 0;\n    const findPane = () => {\n      if (isResults) {\n        const cols = Array.from(document.querySelectorAll('[data-testid=\"lazy-column\"]'));\n        return cols.filter((c) => {\n          const anchor = c.querySelector('a[href*=\"/jobs/view/\"]');\n          if (!anchor) return false;\n          if (expected && anchor.getAttribute('href').indexOf('/jobs/view/' + expected + '/') === -1) return false;\n          return MARKERS.some((m) => (c.innerText || '').indexOf(m) >= 0);\n        }).pop() || null;\n      }\n      const wrapper = document.querySelector('.jobs-search__job-details--wrapper');\n      return wrapper || null;\n    };\n    const paneOk = (pane) => {\n      if (!pane) return false;\n      const anchor = pane.querySelector('a[href*=\"/jobs/view/\"]');\n      if (!anchor) return false;\n      if (expected && anchor.getAttribute('href').indexOf('/jobs/view/' + expected + '/') === -1) return false;\n      const text = pane.innerText || '';\n      return MARKERS.some((m) => text.indexOf(m) >= 0);\n    };\n    let pane = null;\n    const deadline = Date.now() + 10000;\n    while (Date.now() < deadline) {\n      pane = findPane();\n      if (paneOk(pane)) break;\n      await sleep(250);\n    }\n    if (!paneOk(pane)) pane = null;\n    let id = expected;\n    let title = '';\n    let description = '';\n    if (pane) {\n      let prevLen = -1;\n      for (let i = 0; i < 3; i++) {\n        const toggles = Array.from(pane.querySelectorAll('[data-testid=\"expandable-text-button\"], button, [role=\"button\"], span, div')).filter((el) => {\n          if (el.closest('a')) return false;\n          const t = (el.textContent || '').trim();\n          return t.length > 0 && t.length <= 60 && MORE_RE.test(t);\n        });\n        if (!toggles.length) break;\n        let clicked = false;\n        for (const tg of toggles) {\n          try { if (typeof tg.click === 'function') { tg.click(); clicked = true; } } catch (e) {}\n        }\n        if (!clicked) break;\n        await sleep(600);\n        const len = (pane.innerText || '').length;\n        if (len <= prevLen) break;\n        prevLen = len;\n      }\n      const anchor = pane.querySelector('a[href*=\"/jobs/view/\"]');\n      if (!id && anchor) id = (anchor.getAttribute('href').match(/\\/jobs\\/view\\/(\\d+)/) || [])[1] || '';\n      if (!isResults) {\n        const tEl = pane.querySelector('.job-details-jobs-unified-top-card__job-title, h1, h2');\n        title = (tEl && tEl.textContent ? tEl.textContent.trim() : '');\n      }\n      if (!title) title = (anchor && anchor.textContent ? anchor.textContent.trim() : '') || (pane.querySelector('h1,h2') || {}).textContent || '';\n      const text = pane.innerText || '';\n      let markerIndex = -1;\n      for (const m of MARKERS) {\n        const i = text.indexOf(m);\n        if (i >= 0 && (markerIndex < 0 || i < markerIndex)) markerIndex = i;\n      }\n      description = (markerIndex >= 0 ? text.slice(markerIndex) : text).replace(/\\s+/g, ' ').trim().slice(0, 8000);\n    }\n    const seen = String(automaRefData('variables', 'seenIds') || '');\n    const duplicate = id ? seen.split(',').includes(id) : true;\n    automaSetVariable('currentId', id);\n    automaSetVariable('currentTitle', title.trim());\n    automaSetVariable('currentDescription', description);\n    automaSetVariable('applyUrl', id ? 'https://www.linkedin.com/jobs/view/' + id + '/' : '');\n    automaSetVariable('isDuplicate', (duplicate || !description) ? 'true' : 'false');\n    automaSetVariable('seenIds', seen + id + ',');\n    try { await scrollList(); } catch (e) {}\n    finish();\n  } catch (e) {\n    try { automaSetVariable('isDuplicate', 'true'); } catch (e2) {}\n    finish();\n  }\n})();\n","preloadScripts":[],"everyNewTab":false,"runBeforeLoad":false,"onError":"continue"},"label":"javascript-code"},{"id":"fdaeyco","type":"BlockRepeatTask","initialized":false,"position":{"x":3246,"y":204.5},"data":{"disableBlock":false,"repeatFor":"{{variables.max_jobs}}"},"label":"repeat-task"},{"id":"31j6dzj","type":"BlockElementExists","initialized":false,"position":{"x":1715.9813119084224,"y":-37.95500843783353},"data":{"disableBlock":false,"description":"check if non parsed elements exist","findBy":"xpath","selector":"{{variables.listItemJobCardXpathSelector}}","tryCount":1,"timeout":5000,"markEl":false,"throwError":false},"label":"element-exists"},{"id":"4g3tftp","type":"BlockElementExists","initialized":false,"position":{"x":2042.2870292385196,"y":9.673872420832382},"data":{"disableBlock":false,"description":"check if next page exist","findBy":"xpath","selector":"{{variables.nextPageSelector}}","tryCount":1,"timeout":500,"markEl":false,"throwError":false},"label":"element-exists"},{"id":"wstek2k","type":"BlockBasic","initialized":false,"position":{"x":2370.484003409581,"y":8.40617731928478},"data":{"disableBlock":false,"description":"click next page","find