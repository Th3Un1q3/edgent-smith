      {
        "id": "fndc",
        "type": "BlockBasic",
        "initialized": false,
        "position": {
          "x": 2330,
          "y": 143.5
        },
        "data": {
          "disableBlock": false,
          "description": "B2 Scan cards for real jobs (16-hex data-jk + tracking href), skip honeypots, mark active, click to load panel",
          "timeout": 20000,
          "context": "website",
          "code": "(() => {\n  let finished = false;\n  const finish = () => { if (!finished) { finished = true; automaNextBlock(); } };\n  automaSetVariable('currentDescription', '');\n  automaSetVariable('isDuplicate', 'false');\n  try {\n    // Navigation guard (registered once per page): block same-host navigation\n    // away from the /jobs search page (e.g. honeypot cards linking to /viewjob).\n    // Pagination (/jobs path) is allowed; preventDefault does not stop the SPA's\n    // React onClick, so real card clicks still load the detail panel in place.\n    if (!window.__indeedNavGuard) {\n      window.__indeedNavGuard = true;\n      document.addEventListener('click', (e) => {\n        const a = e.target && e.target.closest ? e.target.closest('a[href]') : null;\n        if (!a) return;\n        try {\n          const u = new URL(a.href, location.href);\n          if (u.host === location.host && u.pathname.indexOf('/jobs') === -1) e.preventDefault();\n        } catch (err) {}\n      }, true);\n    }\n    // Wrong-page sanity check: never search for cards on a stray page\n    if (location.pathname.indexOf('/jobs') === -1) {\n      automaSetVariable('cardFound', 'false');\n      finish();\n      return;\n    }\n    // Scan all unmarked cards; select the first REAL job (16-hex data-jk AND\n    // tracking href). Honeypots fail the checks and are marked complete so they\n    // are never retried (nor clicked, nor inserted).\n    let selected = null;\n    for (const card of Array.from(document.querySelectorAll('div[data-testid=\"slider_item\"]'))) {\n      if (card.hasAttribute('data-job-list-item')) continue;\n      const anchor = card.querySelector('a.jcs-JobTitle');\n      const jk = anchor ? (anchor.getAttribute('data-jk') || '') : '';\n      const href = anchor ? (anchor.getAttribute('href') || '') : '';\n      const validJk = /^[a-f0-9]{16}$/i.test(jk);\n      const isTracking = /\\/pagead\\/clk|\\/rc\\/clk/.test(href);\n      if (!anchor || !validJk || !isTracking) {\n        card.setAttribute('data-job-list-item', 'complete');\n        continue;\n      }\n      selected = card;\n      break;\n    }\n    if (selected) {\n      selected.setAttribute('data-job-list-item', 'active');\n      const anchor = selected.querySelector('a.jcs-JobTitle');\n      const jk = anchor ? (anchor.getAttribute('data-jk') || '') : '';\n      const titleEl = anchor ? (anchor.querySelector('span[title]') || anchor.querySelector('span')) : null;\n      const title = titleEl ? (titleEl.textContent || '').replace(/\\s+/g, ' ').trim() : '';\n      automaSetVariable('currentId', jk);\n      automaSetVariable('currentTitle', title);\n      automaSetVariable('applyUrl', jk ? 'https://de.indeed.com/viewjob?jk=' + jk : '');\n      automaSetVariable('cardFound', 'true');\n      automaSetVariable('prevPanelDesc', (document.querySelector('#jobDescriptionText') || { innerText: '' }).innerText || '');\n      if (anchor) {\n        const fireClick = (el) => {\n          const opts = { bubbles: true, cancelable: true, view: window };\n          ['pointerdown', 'pointerup', 'mousedown', 'mouseup', 'click'].forEach((t) => {\n            try { el.dispatchEvent(new MouseEvent(t, opts)); } catch (e) {}\n          });\n          try { el.click(); } catch (e) {}\n        };\n        fireClick(anchor);\n      }\n    } else {\n      automaSetVariable('cardFound', 'false');\n    }\n    finish();\n  } catch (e) { automaSetVariable('cardFound', 'false'); finish(); }\n})();",
          "preloadScripts": [],
          "everyNewTab": false,
          "runBeforeLoad": false
        },
        "label": "javascript-code"
      },
