      {
        "id": "exdc",
        "type": "BlockBasic",
        "initialized": false,
        "position": {
          "x": 2990,
          "y": 340
        },
        "data": {
          "disableBlock": false,
          "description": "C3 Wait for lazy panel + extract description (JSON-LD, fallback #jobDescriptionText)",
          "onError": {
            "enable": true,
            "toDo": "continue"
          },
          "timeout": 20000,
          "context": "website",
          "code": "(async () => {\n  let finished = false;\n  const finish = () => { if (!finished) { finished = true; automaNextBlock(); } };\n  try {\n    // Wrong-page sanity check: never extract from a stray page (e.g. /viewjob\n    // after a hypothetical nav-guard failure) — refuse instead of polluting rows.\n    if (location.pathname.indexOf('/jobs') === -1) {\n      automaSetVariable('currentDescription', '');\n      automaSetVariable('isDuplicate', 'false');\n      finish();\n      return;\n    }\n    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n    const collapse = (s) => s.replace(/\\s+/g, ' ').trim();\n    const stripHtml = (s) => {\n      const div = document.createElement('div');\n      div.innerHTML = s;\n      return div.textContent || '';\n    };\n    const fromLdJson = () => {\n      const scripts = Array.from(document.querySelectorAll('script[type=\"application/ld+json\"]'));\n      for (const script of scripts) {\n        let parsed;\n        try { parsed = JSON.parse(script.textContent || ''); } catch (e) { continue; }\n        if (!parsed || typeof parsed !== 'object') continue;\n        const types = Array.isArray(parsed['@type']) ? parsed['@type'] : [parsed['@type']];\n        if (types.some((t) => typeof t === 'string' && t.indexOf('JobPosting') !== -1)) {\n          if (typeof parsed.description === 'string' && parsed.description.trim()) return parsed.description;\n        }\n      }\n      return '';\n    };\n    const fromPanel = () => {\n      const el = document.querySelector('#jobDescriptionText');\n      return el ? (el.innerText || el.textContent || '') : '';\n    };\n    const seen = automaRefData('variables', 'seenIds') || '0,';\n    const id = automaRefData('variables', 'currentId') || '';\n    const prevRaw = automaRefData('variables', 'prevPanelDesc') || '';\n    const prevTxt = collapse(stripHtml(prevRaw));\n    let raw = '';\n    let txt = '';\n    let broke = false;\n    for (let i = 0; i < 20; i++) {\n      raw = fromLdJson() || fromPanel();\n      txt = collapse(stripHtml(raw));\n      if (txt && (!prevTxt || txt !== prevTxt)) { broke = true; break; }\n      await sleep(500);\n    }\n    let desc = collapse(stripHtml(raw));\n    if (!broke && prevTxt && txt && txt === prevTxt && location.search.indexOf(id) === -1) desc = '';\n    const dup = id ? seen.indexOf(id + ',') >= 0 : false;\n    automaSetVariable('currentDescription', desc.slice(0, 8000));\n    automaSetVariable('isDuplicate', dup ? 'true' : 'false');\n    if (!dup && id) automaSetVariable('seenIds', seen + id + ',');\n    finish();\n  } catch (e) {\n    automaSetVariable('currentDescription', '');\n    automaSetVariable('isDuplicate', 'false');\n    finish();\n  }\n})();",
          "preloadScripts": [],
          "everyNewTab": false,
          "runBeforeLoad": false
        },
        "label": "javascript-code"
