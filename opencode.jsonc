{
    "$schema": "https://opencode.ai/config.json",
    "model": "local/qwen3.6-28b-reap20-a3b",
    "small_model": "local/google/gemma-4-e2b",
    "logLevel": "WARN",
    "formatter": false,
    "lsp": false,
    "tool_output": {
        "max_lines": 200,
        "max_bytes": 8192
    },
    "compaction": {
        "auto": true,
        "prune": true,
        // "reserved": 2000
    },
    "experimental": {
        "continue_loop_on_deny": true
    },
    "instructions": [
        ".opencode/instructions/steering-message.md"
    ],
    "provider": {
        "local": {
            "options": {
                "baseURL": "http://host.docker.internal:1289/v1"
            },
            "npm": "@ai-sdk/openai-compatible",
            "models": {
                "qwen3.6-28b-reap20-a3b": {
                    "name": "l-qwen3.6-28b",
                    "attachment": true,
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 128000,
                        "output": 32768
                    }
                },
                "spark-x2.5-4b": {
                    "name": "l-spark-x2.5-4b",
                    "attachment": true,
                    "limit": {
                        "context": 128000,
                        "output": 32768
                    }
                },
            }
        }
    },
    "permission": {
        "external_directory": {
            "/tmp/*": "allow"
        },
        "webfetch": "deny",
        "list_mcp_resources": "deny",
        "bash": {
            "*": "allow",
            "git *": "deny",
            "rtk git *": "ask",
            "git blame *": "allow",
            "git grep *": "allow",
            "git rev-parse *": "allow",
            "rtk git blame *": "allow",
            "git diff *": "allow",
            "rtk git diff *": "allow",
            "git status *": "allow",
            "rtk git status *": "allow",
            "git show *": "allow",
            "rtk git show *": "allow",
            "git check-ignore *": "allow",
            "rtk git check-ignore *": "allow",
            "git ls *": "allow",
            "rtk git ls *": "allow",
            "git log *": "allow",
            "rtk git log *": "allow",
            "curl *": "deny",
            "rtk curl *": "deny",
        },
        "gateway_*": "allow",
        "gateway_execute_shell_command": "deny",
        "gateway_mcp-exec": "deny",
        "gateway_code-mode": "deny",
        "gateway_mcp-find": "allow"
    },
    "plugin": [
        "@mohak34/opencode-notifier@latest",
    ],
    "mcp": {
        "gateway": {
            "type": "remote",
            "url": "http://mcp_gateway:8080/mcp"
        },
    }
}