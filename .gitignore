# Opencode artifacts
.tmp/*
.logs/
.opencode/plugins/sessions
.opencode/opencode-notifier-state.json
.opencode/.eslintcache
.opencode/coverage/
.opencode/.stryker-tmp/
.opencode/reports/

# DevContainer auto-generated env files
.devcontainer/.env

# Serena private memory namespace (devtools-derived output, PII — never commit)
.serena/memories/private/

# docs (reveal.js)
docs/node_modules/
# dsh harness home (.dsh/ is the SOURCE for the container's ~/.dsh, not the
# live home — see .dsh/README.md): track the config-as-code (settings.yaml,
# cordis.patch.yml, .agent-presets/, README.md); ignore the secret/dummy seed
# files. The machine-state dirs below now live in volumes (dropped on recreate
# or held in dsh_persistent) and are ignored as a safety net for dsh runs
# outside the container and for leftovers from the old whole-directory mount.
# PRIMARY authority: dsh 0.1.1-rc.2 scans DOT via USER_PRESET_DIR (.agent-presets)
# with includeUserRoot:true + trust:user (lib/index.js:851, dsh-agent-presets
# README "Append <dshHome>/.agent-presets as a user root"). DOT is the tracked
# live preset root — do NOT ignore it. Legacy .dsh/agent-presets/ (NO dot) is
# NOT scanned (dump-config shows default:standard only) — kept empty with .gitkeep.
/.dsh/profiles/
/.dsh/sessions/
/.dsh/storages/
/.dsh/.pnpm-store/
/.dsh/.env
/.dsh/.credentials.yaml
# Out-of-process worker subagent runtime (Option B): node_modules is rebuilt
# from the tracked package.json + pnpm-lock.yaml by .devcontainer/setup-dev.sh.
/.dsh/child-runtime/node_modules/
# Scratch downloads used to inspect the dsh-sdk stack (never commit).
/.dsh-sdk-src/
# pnpm store accidentally created at the repo root during a local install.
/.pnpm-store/
/.dsh/child-home/

# Experiment state & baseline artifacts (machine-generated)
experiments/*.state.json
auto_research*.json
# No root package.json exists; a root node_modules is always a stray test-cache artifact.
/node_modules/

# AI-DLC plugin build output: generated from the plugin's own sources by
# .devcontainer/setup-dev.sh. The sources stay tracked; only the build result
# is ignored.
aidlc-plugins/quality-gates/dist/

# AIDLC (awslabs/aidlc-workflows): only machine-local settings are ignored. The
# `.aidlc/` engine and the root `aidlc/` shell are committed scaffold — never add them here.
/aidlc.settings.local.json
/.aidlc/settings.local.json

# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
# END AI-DLC:gitignore
