.env.*.local
!.env.example

# Experiment artifacts (machine-generated, large)
experiments/results/*.json
experiments/baselines/*.json

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Ollama model cache (large binary files)
.ollama/

# pydantic-ai inference cache (not intended for the repo)
pi_cache/
.pi_cache/

# CI eval artefacts
eval_result.json

# MCP configurations (may contain sensitive information)
secrets/

# Opencode artifacts
.tmp/
.logs/
.opencode/plugins/sessions
.opencode/opencode-notifier-state.json
.opencode/.eslintcache
.opencode/coverage/
.opencode/.stryker-tmp/
.opencode/reports/

# DevContainer auto-generated env files
.devcontainer/.env

# Serena private memory namespace (devtools-derived output, PII — never commit)
.serena/memories/private/

# docs (reveal.js)
docs/node_modules/
# dsh harness home (.dsh/ is the SOURCE for the container's ~/.dsh, not the
# live home — see .dsh/README.md): track the config-as-code (settings.yaml,
# cordis.patch.yml, agent-presets/, README.md); ignore the secret/dummy seed
# files. The machine-state dirs below now live in volumes (dropped on recreate
# or held in dsh_persistent) and are ignored as a safety net for dsh runs
# outside the container and for leftovers from the old whole-directory mount.
/.dsh/profiles/
/.dsh/sessions/
/.dsh/storages/
/.dsh/.pnpm-store/
/.dsh/.env
/.dsh/.credentials.yaml
# Out-of-process worker subagent runtime (Option B): node_modules is rebuilt
# from the tracked package.json + pnpm-lock.yaml by .devcontainer/setup-dev.sh.
/.dsh/child-runtime/node_modules/
# Scratch downloads used to inspect the dsh-sdk stack (never commit).
/.dsh-sdk-src/
# pnpm store accidentally created at the repo root during a local install.
/.pnpm-store/
