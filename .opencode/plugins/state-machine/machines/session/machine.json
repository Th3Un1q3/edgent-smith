{
  "id": "session",
  "initial": "admission",
  "on": {
    "system_interrupted": {
      "target": "#session.towards_goal.parked",
      "guard": {
        "type": "not_parked",
        "params": {}
      }
    }
  },
  "states": {
    "admission": {
      "always": [
        {
          "guard": {
            "type": "session_agent",
            "params": {
              "in": [
                "rug"
              ]
            }
          },
          "target": "#session.towards_goal"
        },
        {
          "target": "#session.free_work"
        }
      ],
      "on": {
        "admit": [
          {
            "guard": {
              "type": "session_agent",
              "params": {
                "in": [
                  "rug"
                ]
              }
            },
            "target": "#session.towards_goal",
            "actions": [
              {
                "type": "admit_identity",
                "params": {}
              }
            ]
          },
          {
            "target": "#session.free_work",
            "actions": [
              {
                "type": "admit_identity",
                "params": {}
              }
            ]
          }
        ]
      }
    },
    "towards_goal": {
      "initial": "define_goal",
      "on": {
        "system_idle": [
          {
            "guard": {
              "type": "counter_below",
              "params": {
                "key": "nudges",
                "limit": 3
              }
            },
            "actions": [
              {
                "type": "record",
                "params": {
                  "op": "increment",
                  "key": "nudges"
                }
              },
              {
                "type": "prompt",
                "params": {
                  "text": "You are idle in `${state}`, which has not finished. ${state === 'define_goal' ? 'Send SET_GOAL with the goal this session should accomplish.' : state === 'work' ? 'Call signal_send with CLAIM_WORK when the current work unit is done.' : state === 'check' ? 'The quality check is running; wait for its result instead of stopping.' : state === 'validate' ? 'Answer the validation prompt, or send GOAL_ACHIEVED or GOAL_INCOMPLETE.' : state === 'memorize' ? 'Send LESSON with what this attempt taught.' : state === 'retrospective' ? 'Run the retrospective command and send RETROSPECTIVE_COMPLETE.' : 'Continue the work this state waits for.'} The loop stays in `${state}` until a signal or command moves it on, so act rather than stop.",
                  "description": "Nudge the agent to do what the active state waits for instead of idling."
                }
              }
            ]
          },
          {
            "target": "#session.towards_goal.panic",
            "actions": [
              {
                "type": "record",
                "params": {
                  "op": "fail",
                  "reason": "idle budget exhausted"
                }
              },
              {
                "type": "prompt",
                "params": {
                  "text": "The loop is blocked. Report what stopped it, revert nothing without the user line, and ask before any destructive step. Parked for investigation: ${context.failure?.reason ?? 'unknown'}${context.failure?.detail ? ' (' + context.failure.detail + ')' : ''}. Follow the progressive-panic skill.",
                  "skills": [
                    "progressive-panic"
                  ],
                  "description": "Report that the idle budget ran out and the loop is parked."
                }
              }
            ]
          }
        ],
        "reset_goal": {
          "target": "#session.towards_goal.define_goal",
          "actions": [
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "goal",
                "source": {
                  "from": "literal",
                  "value": ""
                }
              }
            },
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "intent",
                "source": {
                  "from": "literal",
                  "value": "none"
                }
              }
            },
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "attempts",
                "source": {
                  "from": "literal",
                  "value": 0
                }
              }
            },
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "nudges",
                "source": {
                  "from": "literal",
                  "value": 0
                }
              }
            }
          ]
        }
      },
      "states": {
        "define_goal": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "Follow progressive-goal-setting skill.",
                "skills": [
                  "progressive-goal-setting"
                ],
                "description": "Ask the agent what goal this session should accomplish."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "SET_GOAL"
                ]
              }
            },
            {
              "type": "recall_memories",
              "params": {
                "namespace": "preferences/user"
              }
            },
            {
              "type": "set_tools_policy",
              "params": {
                "stateId": "define_goal",
                "allowedTools": [
                  "signal_send",
                  "execute",
                  "question",
                  "skill"
                ],
                "errorMessage": "Tool <name> is blocked in <state>. Call signal_send with SET_GOAL and a goal to continue."
              }
            }
          ],
          "exit": [
            {
              "type": "set_tools_policy",
              "params": {
                "allowedTools": null
              }
            }
          ],
          "on": {
            "agent_sent_signal.SET_GOAL": {
              "target": "plan",
              "actions": [
                {
                  "type": "record",
                  "params": {
                    "op": "set",
                    "key": "goal",
                    "source": {
                      "from": "payload",
                      "field": "goal"
                    }
                  }
                }
              ]
            },
            "callback.memories_ready": {
              "actions": [
                {
                  "type": "record_callback",
                  "params": {
                    "reportTo": "memories_ready",
                    "key": "preferences/user"
                  }
                }
              ]
            }
          }
        },
        "plan": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "Follow progressive-plan skill.",
                "skills": [
                  "progressive-plan"
                ],
                "description": "Ask the agent to shape the goal before dispatching any work."
              }
            },
            {
              "type": "set_tools_policy",
              "params": {
                "stateId": "plan",
                "allowedTools": [
                  "signal_send",
                  "question",
                  "skill"
                ],
                "errorMessage": "Plan first: <name> is blocked in plan. Write the decomposition, then signal PLAN_READY."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "PLAN_READY"
                ]
              }
            }
          ],
          "exit": [
            {
              "type": "set_tools_policy",
              "params": {
                "allowedTools": null
              }
            }
          ],
          "on": {
            "agent_sent_signal.PLAN_READY": {
              "target": "work"
            }
          }
        },
        "work": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "Work towards: ${sentence(context.goal)} Memories: ${context.memories.join(' | ') || 'none'}. Preferences: ${sentence(context.injected['preferences/user']?.full.join(' | ') || 'none')} Follow the progressive-work skill.",
                "skills": [
                  "progressive-work",
                  "task-delegation"
                ],
                "description": "Remind the agent of the goal and the memories to work from."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "CLAIM_WORK"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.CLAIM_WORK": {
              "target": "check"
            },
            "callback.memories_ready": {
              "actions": [
                {
                  "type": "record_callback",
                  "params": {
                    "reportTo": "memories_ready",
                    "key": "preferences/user"
                  }
                }
              ]
            }
          }
        },
        "check": {
          "entry": [
            {
              "type": "run_shell",
              "params": {
                "cmd": "just opencode::typecheck",
                "reportTo": "quality_check_ready"
              }
            }
          ],
          "on": {
            "callback.quality_check_ready": [
              {
                "target": "validate",
                "guard": {
                  "type": "callback_ok",
                  "params": {}
                },
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "quality_check_ready"
                    }
                  }
                ]
              },
              {
                "target": "#session.towards_goal.panic",
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "quality_check_ready"
                    }
                  },
                  {
                    "type": "prompt",
                    "params": {
                      "text": "Quality check failed: ${context.failure?.reason ?? 'unknown'}${context.failure?.detail ? ' (' + context.failure.detail + ')' : ''}. Parked in panic for investigation.",
                      "description": "Report that the quality check failed and the loop is parked."
                    }
                  }
                ]
              }
            ]
          }
        },
        "validate": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "Follow progressive-validation skill.",
                "skills": [
                  "progressive-validation"
                ],
                "description": "Ask the agent to judge whether the goal is met."
              }
            },
            {
              "type": "spawn_subagent",
              "params": {
                "agent": "judge",
                "description": "Ask a judge subagent to grade the goal against the evidence.",
                "text": "Judge whether this session's goal is met. End your answer with exactly one JSON object: {\"verdict\":\"pass\"|\"fail\",\"reason\":\"<one non-empty sentence>\"}",
                "reportTo": "subagent_ready",
                "timeoutMs": 120000
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "GOAL_ACHIEVED",
                  "GOAL_INCOMPLETE"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.GOAL_ACHIEVED": {
              "target": "memorize",
              "actions": [
                {
                  "type": "record",
                  "params": {
                    "op": "set",
                    "key": "intent",
                    "source": {
                      "from": "literal",
                      "value": "improvement"
                    }
                  }
                }
              ]
            },
            "agent_sent_signal.GOAL_INCOMPLETE": [
              {
                "target": "memorize",
                "guard": {
                  "type": "counter_below",
                  "params": {
                    "key": "attempts",
                    "limit": {
                      "fromContext": "maxAttempts"
                    }
                  }
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "increment",
                      "key": "attempts"
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "intent",
                      "source": {
                        "from": "literal",
                        "value": "lesson"
                      }
                    }
                  }
                ]
              },
              {
                "target": "#session.towards_goal.panic",
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "fail",
                      "reason": "attempts exhausted"
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "intent",
                      "source": {
                        "from": "literal",
                        "value": "lesson"
                      }
                    }
                  },
                  {
                    "type": "prompt",
                    "params": {
                      "text": "The loop is blocked. Report what stopped it, revert nothing without the user line, and ask before any destructive step. Parked for investigation: ${context.failure?.reason ?? 'unknown'}${context.failure?.detail ? ' (' + context.failure.detail + ')' : ''}. Follow the progressive-panic skill.",
                      "skills": [
                        "progressive-panic"
                      ],
                      "description": "Report that the attempts ran out and the loop is parked."
                    }
                  }
                ]
              }
            ],
            "callback.subagent_ready": [
              {
                "target": "memorize",
                "guard": {
                  "type": "callback_ok",
                  "params": {}
                },
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "subagent_ready"
                    }
                  }
                ]
              },
              {
                "target": "#session.towards_goal.panic",
                "guard": {
                  "type": "field_present",
                  "params": {
                    "field": "verdict"
                  }
                },
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "subagent_ready"
                    }
                  },
                  {
                    "type": "prompt",
                    "params": {
                      "text": "The judge answered: ${context.results.subagent_ready?.output ?? context.failure?.reason ?? 'unknown'}. Parked in panic for investigation.",
                      "description": "Report the judge's reason and park the loop."
                    }
                  }
                ]
              },
              {
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "subagent_ready"
                    }
                  }
                ]
              }
            ]
          }
        },
        "memorize": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "${context.intent === 'improvement' ? 'Name one improvement.' : 'Name what to change next attempt.'}",
                "description": "Request a lesson to carry into the next attempt."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "LESSON"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.LESSON": [
              {
                "target": "retrospective",
                "guard": {
                  "type": "improvement_lesson",
                  "params": {}
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "push",
                      "key": "improvements",
                      "source": {
                        "from": "payload",
                        "field": "text"
                      }
                    }
                  }
                ]
              },
              {
                "target": "retrospective",
                "guard": {
                  "type": "field_present",
                  "params": {
                    "field": "text"
                  }
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "push",
                      "key": "memories",
                      "source": {
                        "from": "payload",
                        "field": "text"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "retrospective": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "Follow progressive-retrospective skill.",
                "skills": [
                  "progressive-retrospective",
                  "harness-management"
                ],
                "description": "Ask the agent to run the retrospective and report when the command finishes."
              }
            },
            {
              "type": "run_command",
              "params": {
                "name": "sessions/retrospect"
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "RETROSPECTIVE_COMPLETE"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.RETROSPECTIVE_COMPLETE": [
              {
                "target": "#session.towards_goal.parked",
                "guard": {
                  "type": "improvement_lesson",
                  "params": {}
                }
              },
              {
                "target": "work"
              }
            ]
          }
        },
        "parked": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "text": "Goal reached: ${sentence(context.goal)} Improvements: ${sentence(context.improvements.join(' | ') || 'none')} Waiting for your next instruction.",
                "description": "Send a new message to resume the loop from a fresh goal."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": []
              }
            }
          ],
          "on": {
            "system_idle": {
              "actions": []
            },
            "system_user_input": {
              "actions": [
                {
                  "type": "emit_parent",
                  "params": {
                    "type": "reset_goal"
                  }
                }
              ]
            }
          }
        },
        "panic": {
          "entry": [
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "LESSON"
                ]
              }
            }
          ],
          "on": {
            "system_idle": {
              "actions": []
            },
            "agent_sent_signal.LESSON": [
              {
                "target": "#session.towards_goal.work",
                "guard": {
                  "type": "field_present",
                  "params": {
                    "field": "text"
                  }
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "push",
                      "key": "memories",
                      "source": {
                        "from": "payload",
                        "field": "text"
                      }
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "attempts",
                      "source": {
                        "from": "literal",
                        "value": 0
                      }
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "nudges",
                      "source": {
                        "from": "literal",
                        "value": 0
                      }
                    }
                  }
                ]
              }
            ],
            "system_user_input": {
              "actions": [
                {
                  "type": "emit_parent",
                  "params": {
                    "type": "reset_goal"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "free_work": {
      "on": {
        "system_interrupted": {
          "actions": []
        }
      }
    }
  }
}
