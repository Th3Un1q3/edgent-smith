{
  "id": "session",
  "initial": "admission",
  "on": {
    "system_interrupted": {
      "target": "#session.towards_goal.parked",
      "guard": {
        "type": "not_parked",
        "params": {}
      }
    },
    "callback.skill_ready": {
      "actions": [
        {
          "type": "record_callback",
          "params": {
            "reportTo": "skill_ready"
          }
        },
        {
          "type": "mark_skill",
          "params": {
            "name": "task-delegation"
          }
        }
      ]
    }
  },
  "states": {
    "admission": {
      "always": [
        {
          "guard": {
            "type": "session_agent",
            "params": {
              "in": [
                "rug"
              ]
            }
          },
          "target": "#session.towards_goal"
        },
        {
          "target": "#session.free_work"
        }
      ],
      "on": {
        "admit": [
          {
            "guard": {
              "type": "session_agent",
              "params": {
                "in": [
                  "rug"
                ]
              }
            },
            "target": "#session.towards_goal",
            "actions": [
              {
                "type": "admit_identity",
                "params": {}
              }
            ]
          },
          {
            "target": "#session.free_work",
            "actions": [
              {
                "type": "admit_identity",
                "params": {}
              }
            ]
          }
        ]
      }
    },
    "towards_goal": {
      "initial": "define_goal",
      "on": {
        "system_idle": [
          {
            "guard": {
              "type": "counter_below",
              "params": {
                "key": "nudges",
                "limit": 3
              }
            },
            "actions": [
              {
                "type": "record",
                "params": {
                  "op": "increment",
                  "key": "nudges"
                }
              },
              {
                "type": "prompt",
                "params": {
                  "template": "idle_nudge",
                  "description": "Nudge the agent to do what the active state waits for instead of idling."
                }
              }
            ]
          },
          {
            "target": "#session.towards_goal.panic",
            "actions": [
              {
                "type": "record",
                "params": {
                  "op": "fail",
                  "reason": "idle budget exhausted"
                }
              },
              {
                "type": "prompt",
                "params": {
                  "template": "panic_escalation",
                  "description": "Report that the idle budget ran out and the loop is parked."
                }
              }
            ]
          }
        ],
        "reset_goal": {
          "target": "#session.towards_goal.define_goal",
          "actions": [
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "goal",
                "source": {
                  "from": "literal",
                  "value": ""
                }
              }
            },
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "intent",
                "source": {
                  "from": "literal",
                  "value": "none"
                }
              }
            },
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "attempts",
                "source": {
                  "from": "literal",
                  "value": 0
                }
              }
            },
            {
              "type": "record",
              "params": {
                "op": "set",
                "key": "nudges",
                "source": {
                  "from": "literal",
                  "value": 0
                }
              }
            }
          ]
        }
      },
      "states": {
        "define_goal": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "template": "goal_request",
                "description": "Ask the agent what goal this session should accomplish."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "SET_GOAL"
                ]
              }
            },
            {
              "type": "recall_memories",
              "params": {
                "namespace": "preferences/user"
              }
            },
            {
              "type": "set_tools_policy",
              "params": {
                "stateId": "define_goal",
                "allowedTools": [
                  "signal_send",
                  "execute",
                  "question",
                  "skill"
                ],
                "errorMessage": "Tool <name> is blocked in <state>. Call signal_send with SET_GOAL and a goal to continue."
              }
            }
          ],
          "exit": [
            {
              "type": "set_tools_policy",
              "params": {
                "allowedTools": null
              }
            }
          ],
          "on": {
            "agent_sent_signal.SET_GOAL": {
              "target": "work",
              "actions": [
                {
                  "type": "record",
                  "params": {
                    "op": "set",
                    "key": "goal",
                    "source": {
                      "from": "payload",
                      "field": "goal"
                    }
                  }
                }
              ]
            },
            "callback.memories_ready": {
              "actions": [
                {
                  "type": "record_callback",
                  "params": {
                    "reportTo": "memories_ready",
                    "key": "preferences/user"
                  }
                }
              ]
            }
          }
        },
        "work": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "template": "work_towards_goal",
                "description": "Remind the agent of the goal and the memories to work from."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "CLAIM_WORK"
                ]
              }
            },
            {
              "type": "activate_skill",
              "params": {
                "name": "task-delegation"
              }
            }
          ],
          "on": {
            "agent_sent_signal.CLAIM_WORK": {
              "target": "check"
            },
            "callback.memories_ready": {
              "actions": [
                {
                  "type": "record_callback",
                  "params": {
                    "reportTo": "memories_ready",
                    "key": "preferences/user"
                  }
                }
              ]
            }
          }
        },
        "check": {
          "entry": [
            {
              "type": "run_shell",
              "params": {
                "cmd": "just opencode::typecheck",
                "reportTo": "quality_check_ready"
              }
            }
          ],
          "on": {
            "callback.quality_check_ready": [
              {
                "target": "validate",
                "guard": {
                  "type": "callback_ok",
                  "params": {}
                },
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "quality_check_ready"
                    }
                  }
                ]
              },
              {
                "target": "#session.towards_goal.panic",
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "quality_check_ready"
                    }
                  },
                  {
                    "type": "prompt",
                    "params": {
                      "template": "quality_check_failed",
                      "description": "Report that the quality check failed and the loop is parked."
                    }
                  }
                ]
              }
            ]
          }
        },
        "validate": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "template": "validation_self_report",
                "description": "Ask the agent to judge whether the goal is met."
              }
            },
            {
              "type": "spawn_subagent",
              "params": {
                "agent": "judge",
                "description": "Ask a judge subagent to grade the goal against the evidence.",
                "text": "Judge whether this session's goal is met. End your answer with exactly one JSON object: {\"verdict\":\"pass\"|\"fail\",\"reason\":\"<one non-empty sentence>\"}",
                "reportTo": "subagent_ready",
                "timeoutMs": 120000
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "GOAL_ACHIEVED",
                  "GOAL_INCOMPLETE"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.GOAL_ACHIEVED": {
              "target": "memorize",
              "actions": [
                {
                  "type": "record",
                  "params": {
                    "op": "set",
                    "key": "intent",
                    "source": {
                      "from": "literal",
                      "value": "improvement"
                    }
                  }
                }
              ]
            },
            "agent_sent_signal.GOAL_INCOMPLETE": [
              {
                "target": "memorize",
                "guard": {
                  "type": "counter_below",
                  "params": {
                    "key": "attempts",
                    "limit": {
                      "fromContext": "maxAttempts"
                    }
                  }
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "increment",
                      "key": "attempts"
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "intent",
                      "source": {
                        "from": "literal",
                        "value": "lesson"
                      }
                    }
                  }
                ]
              },
              {
                "target": "#session.towards_goal.panic",
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "fail",
                      "reason": "attempts exhausted"
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "intent",
                      "source": {
                        "from": "literal",
                        "value": "lesson"
                      }
                    }
                  },
                  {
                    "type": "prompt",
                    "params": {
                      "template": "panic_escalation",
                      "description": "Report that the attempts ran out and the loop is parked."
                    }
                  }
                ]
              }
            ],
            "callback.subagent_ready": [
              {
                "target": "memorize",
                "guard": {
                  "type": "callback_ok",
                  "params": {}
                },
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "subagent_ready"
                    }
                  }
                ]
              },
              {
                "target": "#session.towards_goal.panic",
                "guard": {
                  "type": "field_present",
                  "params": {
                    "field": "verdict"
                  }
                },
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "subagent_ready"
                    }
                  },
                  {
                    "type": "prompt",
                    "params": {
                      "template": "quality_check_failed",
                      "description": "Report the judge's reason and park the loop."
                    }
                  }
                ]
              },
              {
                "actions": [
                  {
                    "type": "record_callback",
                    "params": {
                      "reportTo": "subagent_ready"
                    }
                  }
                ]
              }
            ]
          }
        },
        "memorize": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "template": "memorize",
                "description": "Request a lesson to carry into the next attempt."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "LESSON"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.LESSON": [
              {
                "target": "retrospective",
                "guard": {
                  "type": "improvement_lesson",
                  "params": {}
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "push",
                      "key": "improvements",
                      "source": {
                        "from": "payload",
                        "field": "text"
                      }
                    }
                  }
                ]
              },
              {
                "target": "retrospective",
                "guard": {
                  "type": "field_present",
                  "params": {
                    "field": "text"
                  }
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "push",
                      "key": "memories",
                      "source": {
                        "from": "payload",
                        "field": "text"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "retrospective": {
          "entry": [
            {
              "type": "activate_skill",
              "params": {
                "name": "harness-management"
              }
            },
            {
              "type": "run_command",
              "params": {
                "name": "sessions/retrospect"
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "RETROSPECTIVE_COMPLETE"
                ]
              }
            }
          ],
          "on": {
            "agent_sent_signal.RETROSPECTIVE_COMPLETE": [
              {
                "target": "#session.towards_goal.parked",
                "guard": {
                  "type": "improvement_lesson",
                  "params": {}
                }
              },
              {
                "target": "work"
              }
            ]
          }
        },
        "parked": {
          "entry": [
            {
              "type": "prompt",
              "params": {
                "template": "park_summary",
                "description": "Send a new message to resume the loop from a fresh goal."
              }
            },
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": []
              }
            }
          ],
          "on": {
            "system_idle": {
              "actions": []
            },
            "system_user_input": {
              "actions": [
                {
                  "type": "emit_parent",
                  "params": {
                    "type": "reset_goal"
                  }
                }
              ]
            }
          }
        },
        "panic": {
          "entry": [
            {
              "type": "update_signals_policy",
              "params": {
                "set_enabled_signals": [
                  "LESSON"
                ]
              }
            }
          ],
          "on": {
            "system_idle": {
              "actions": []
            },
            "agent_sent_signal.LESSON": [
              {
                "target": "#session.towards_goal.work",
                "guard": {
                  "type": "field_present",
                  "params": {
                    "field": "text"
                  }
                },
                "actions": [
                  {
                    "type": "record",
                    "params": {
                      "op": "push",
                      "key": "memories",
                      "source": {
                        "from": "payload",
                        "field": "text"
                      }
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "attempts",
                      "source": {
                        "from": "literal",
                        "value": 0
                      }
                    }
                  },
                  {
                    "type": "record",
                    "params": {
                      "op": "set",
                      "key": "nudges",
                      "source": {
                        "from": "literal",
                        "value": 0
                      }
                    }
                  }
                ]
              }
            ],
            "system_user_input": {
              "actions": [
                {
                  "type": "emit_parent",
                  "params": {
                    "type": "reset_goal"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "free_work": {
      "on": {
        "system_interrupted": {
          "actions": []
        }
      }
    }
  }
}
