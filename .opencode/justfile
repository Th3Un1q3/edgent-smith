set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-load := true
set dotenv-override := true
set export := true
set working-directory := "."

# Install dependencies for CI. The committed bun.lock pins resolved versions.
deps:
    bun install --frozen-lockfile

# Run tests for opencode plugins using Bun and Vitest. This command is intended to be run from the root of the opencode repository.

# --coverage.provider istanbul forces Istanbul on Bun (Bun lacks V8 Profiler API that Vitest v4's default v8 provider requires).
test *ARGS:
    bun run --bun test {{ ARGS }} --coverage.provider=istanbul

# Run linter for opencode plugins
lint *ARGS:
    bun run --bun lint {{ ARGS }}

# Run typecheck for opencode plugins
# Directory args (ending with /) are stripped because forwarding them as file paths to tsc
# causes it to ignore tsconfig.json, producing TS5112. The include patterns in tsconfig.json

# already cover all files that a directory arg would target. Flags like --skipLibCheck are preserved.
typecheck *ARGS:
    @_filtered=""; for _a in {{ ARGS }}; do if [ "${_a%/}" != "$_a" ]; then continue; fi; _filtered="${_filtered} ${_a}"; done; bun run --bun typecheck $_filtered

# Runs mutation tests, allows detecting parts of code that lack proper tests. Use --mutate <file-name> parameter to scope mutation to a single file. Example: --mutate plugins/tool-limit-reminder.ts.
mutation *ARGS:
    @bun stryker {{ ARGS }}

# Keep the opencode background server up: poll `service status`, restart it when stopped. Exit with Ctrl-C or SIGTERM.
oc-service interval="5":
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'echo "oc-service: signal received, exiting"; exit 0' INT TERM
    echo "oc-service: watching every ${interval}s (Ctrl-C or SIGTERM to stop)"
    while true; do
      # `opencode service status` exits 0 for both states and prints a URL only while the server runs.
      if [[ "$(opencode service status 2>&1 || true)" != http* ]]; then
        echo "oc-service: service stopped, running 'opencode service start'"
        opencode service start || echo "oc-service: start failed, retrying in ${interval}s"
      fi
      sleep "${interval}" &
      wait $! || true
    done
